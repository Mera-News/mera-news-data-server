# syntax=docker/dockerfile:1
# The news API as a container. It reads its settings from the environment
# (see .env.example and docs/self-host.md); it does not start without
# MERA_NEWS_API_KEY unless NEWS_API_OPEN=true.

FROM node:24-slim AS builder
WORKDIR /usr/src/app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build:news-api && npm prune --omit=dev

FROM node:24-slim
WORKDIR /usr/src/app
RUN groupadd -g 1001 nodejs && useradd -m -u 1001 -g nodejs nestjs
COPY --from=builder /usr/src/app/dist ./dist
COPY --from=builder /usr/src/app/node_modules ./node_modules
COPY --from=builder /usr/src/app/package*.json ./
USER nestjs
ENV NODE_ENV=production
EXPOSE 8080
CMD ["node", "dist/apps/mera-server-news-api/main.js"]
