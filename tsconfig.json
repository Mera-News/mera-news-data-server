{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "target": "ES2021",
    "lib": [
      "ES2023"
    ],
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@mera/async": [
        "./apps/mera-server-async/src"
      ],
      "@mera/async/*": [
        "./apps/mera-server-async/src/*"
      ],
      "@mera/models": [
        "./libs/mera-models/src"
      ],
      "@mera/models/*": [
        "./libs/mera-models/src/*"
      ],
      "@mera/news-core": [
        "./libs/mera-news-core/src"
      ],
      "@mera/news-core/*": [
        "./libs/mera-news-core/src/*"
      ],
      "@mera/shared": [
        "./libs/mera-shared/src"
      ],
      "@mera/shared/*": [
        "./libs/mera-shared/src/*"
      ]
    },
    "types": [
      "node",
      "jest"
    ]
  }
}
