{
  "name": "mera-news-data-server",
  "version": "0.0.1",
  "description": "News ingest and news API for Mera News: RSS in, translated and embedded articles out.",
  "author": "Mera Labs",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "async": "nest start mera-server-async",
    "news-api": "nest start mera-server-news-api",
    "scripts": "nest start mera-scripts --",
    "load-rss": "nest start mera-scripts -- load-rss",
    "status": "nest start mera-scripts -- status",
    "topic-scores": "nest start mera-scripts -- topic-scores",
    "build:async": "nest build mera-server-async",
    "build:news-api": "nest build mera-server-news-api",
    "build:scripts": "nest build mera-scripts",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{apps,libs,test}/**/*.ts\"",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects unit",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects integration",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config test/e2e/jest.config.js --runInBand",
    "boot-smoke": "node test/harness/boot-smoke.mjs",
    "check:local": "npm run typecheck && npm run build:async && npm run build:scripts && npm run build:news-api && npm run boot-smoke && npm test -- --maxWorkers=2 && npm run test:integration -- --maxWorkers=2"
  },
  "dependencies": {
    "@apollo/server": "^5.5.0",
    "@as-integrations/express5": "^1.1.2",
    "@keyv/redis": "^5.1.6",
    "@nestjs/apollo": "^14.1.1",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/cache-manager": "^12.0.2",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/graphql": "^14.1.0",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "axios": "^1.12.2",
    "bullmq": "^6.5.3",
    "cache-manager": "^7.2.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cld3-asm": "^4.0.0",
    "cockatiel": "^4.0.0",
    "country-codes-list": "^3.2.0",
    "dotenv": "^18.0.3",
    "google-auth-library": "^11.3.2",
    "graphql": "^16.14.2",
    "he": "^2.0.0",
    "helmet": "^8.1.0",
    "https-proxy-agent": "^9.1.0",
    "i18n-iso-countries": "^7.14.0",
    "ioredis": "^5.11.1",
    "moment-timezone": "^0.6.0",
    "mongodb": "~7.7.0",
    "mongoose": "^9.11.4",
    "nest-commander": "^3.21.0",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "redis": "^6.3.1",
    "reflect-metadata": "^0.2.2",
    "rss-parser": "^3.13.0",
    "rxjs": "^7.8.1",
    "string-strip-html": "^13.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@types/express": "^5.0.0",
    "@types/he": "^1.2.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "msw": "^3.0.6",
    "prettier": "3.8.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.20.0",
    "webpack": "^5.105.4",
    "webpack-node-externals": "^3.0.0"
  },
  "overrides": {
    "picomatch": "4.0.4",
    "path-to-regexp": "8.4.2",
    "lodash": "4.18.1",
    "nanoid": "3.3.20",
    "minimatch@3": {
      "brace-expansion": "1.1.21"
    },
    "@golevelup/nestjs-discovery": "^7.1.0"
  }
}
