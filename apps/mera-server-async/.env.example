# mera-server-async environment (example)
# Copy to .env and fill in real values. Secrets are injected via Secret Manager
# in deployed environments.

MONGODB_URI=mongodb://localhost:27017/mera-db?directConnection=true
NODE_ENV=development
PORT=3002

# --- Redis: BullMQ queues/flows (news-bullmq-redis, noeviction) ---
REDIS_URL=redis://localhost:6379
# BullMQ key prefix. Default `bull` (BullMQ's own default = no-op). Staging
# shares prod's instance and sets `bull-stg` to isolate its queues/flows.
# BULLMQ_PREFIX=bull

# --- Redis: volatile TTL'd data cache (news-persistent-redis, volatile-ttl) ---
# RSS-dedup fingerprints + pub-source-info. Falls back to REDIS_URL when unset,
# so this is a no-op until infra points it at the separate persistent instance.
# PERSISTENT_REDIS_URL=redis://localhost:6379
# Cache key prefix. Empty/unset = no prefix (current behavior). Staging shares
# prod's persistent instance and sets `stg:` so its cache keys never collide.
# CACHE_KEY_PREFIX=

# --- Pipeline providers / misc ---
MERA_SERVER_ASYNC_API_KEY=change-me
EMBEDDING_PROVIDER=fake
TRANSLATION_PROVIDER=fake

# --- Provider keys: needed only when the matching provider is on ---
# EMBEDDING_PROVIDER=jina
# JINA_API_KEY=
# TRANSLATION_PROVIDER=gemini with GEMINI_TRANSPORT=developer (the default)
# GEMINI_API_KEY=
